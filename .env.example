# MongoDB Atlas connection string (get from https://cloud.mongodb.com)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/qilzir?retryWrites=true&w=majority

# URL of your deployed frontend (for CORS)
FRONTEND_URL=https://qilzir.com

# Port for the API server (default: 4000)
PORT=4000
